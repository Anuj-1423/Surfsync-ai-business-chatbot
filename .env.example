# OpenAI chat completions. Required in production for AI-generated responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase project URL and server-side service role key.
# Service role credentials MUST remain server-side and out of NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
